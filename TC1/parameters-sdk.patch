+/* Read the 3.5 CRC after application data, including frozen TC1 layouts.
+ * Validate both slots before restoring defaults; never migrate an unchecked prefix.
+ * A read/write failure is returned to the caller, not treated as corrupt settings.
+ */
+static OSStatus try_old_para(system_context_t *inContext)
+{
+    uint32_t size;
+    for (size = inContext->user_config_data_size; size;
+         size = size == inContext->user_config_data_size ? app_config_legacy_size() : app_config_legacy_next_size(size)) {
+        unsigned int slot;
+        if (size > inContext->user_config_data_size) return kSizeErr;
+        for (slot = 0; slot < 2; ++slot) {
+            mico_partition_t part = slot ? MICO_PARTITION_PARAMETER_2 : MICO_PARTITION_PARAMETER_1;
+            uint32_t offset = 0;
+            uint16_t expected, actual;
+            CRC16_Context crc;
+            OSStatus err;
+            err = MicoFlashRead(part, &offset, (uint8_t *)&inContext->flashContentInRam, sizeof(system_config_t));
+            require_noerr(err, exit);
+            offset = mico_context_section_offsets[PARA_APP_DATA_SECTION];
+            err = MicoFlashRead(part, &offset, inContext->user_config_data, size);
+            require_noerr(err, exit);
+            err = MicoFlashRead(part, &offset, (uint8_t *)&expected, CRC_SIZE);
+            require_noerr(err, exit);
+            CRC16_Init(&crc);
+            CRC16_Update(&crc, &inContext->flashContentInRam.micoSystemConfig, SYS_CONFIG_SIZE);
+            CRC16_Update(&crc, inContext->user_config_data, size);
+            CRC16_Final(&crc, &actual);
+            if (actual && actual == expected &&
+                inContext->flashContentInRam.micoSystemConfig.magic_number == SYS_MAGIC_NUMBR &&
+                (size == inContext->user_config_data_size || app_config_migrate_legacy(inContext->user_config_data, size))) {
+                seedNum = inContext->flashContentInRam.micoSystemConfig.seed;
+                return internal_update_config(inContext);
+            }
+            continue;
+exit:
+            return err;
+        }
     }
-}
