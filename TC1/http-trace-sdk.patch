@@ -0,0 +1,24 @@
+#pragma once
+/* Numeric phases are diagnostic metadata, never request payloads. */
+enum {
+ HTTP_TRACE_LISTEN_ENTER=1, HTTP_TRACE_LISTEN_RETURN,
+ HTTP_TRACE_ACCEPT_ENTER, HTTP_TRACE_ACCEPT_RETURN,
+ HTTP_TRACE_NONBLOCK_ENTER, HTTP_TRACE_NONBLOCK_RETURN,
+ HTTP_TRACE_CLOSE_ENTER, HTTP_TRACE_CLOSE_RETURN,
+ HTTP_TRACE_HANDLE_ENTER, HTTP_TRACE_HANDLE_RETURN,
+ HTTP_TRACE_SEND_SELECT_ENTER, HTTP_TRACE_SEND_SELECT_RETURN,
+ HTTP_TRACE_SEND_ENTER, HTTP_TRACE_SEND_RETURN,
+ HTTP_TRACE_RECV_SELECT_ENTER, HTTP_TRACE_RECV_SELECT_RETURN,
+ HTTP_TRACE_RECV_ENTER, HTTP_TRACE_RECV_RETURN,
+ HTTP_TRACE_HEADERS_ENTER, HTTP_TRACE_HEADERS_RETURN,
+ HTTP_TRACE_BODY_ENTER, HTTP_TRACE_BODY_RETURN,
+ HTTP_TRACE_PARSE_ENTER, HTTP_TRACE_PARSE_RETURN,
+ HTTP_TRACE_DISPATCH_ENTER, HTTP_TRACE_DISPATCH_RETURN,
+ HTTP_TRACE_REPLY_ENTER, HTTP_TRACE_REPLY_RETURN
+};
+#ifdef PHICOMM_HTTP_TRACE
+void phicomm_http_trace(unsigned phase, int fd, int detail);
+#define HTTP_TRACE(phase,fd,detail) phicomm_http_trace(phase,fd,detail)
+#else
+#define HTTP_TRACE(phase,fd,detail) ((void)0)
+#endif
