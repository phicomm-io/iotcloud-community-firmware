+static uint16_t para_config_crc(const system_context_t *context, mico_partition_t part, uint8_t *tmp)
+{
+    uint16_t result;
+    uint32_t offset = mico_context_section_offsets[PARA_MICO_DATA_SECTION];
+    uint32_t end = MicoFlashGetInfo(part)->partition_length - CRC_SIZE;
+    CRC16_Context crc;
+    CRC16_Init(&crc);
+    while (offset < end) {
+        uint32_t i, len = end - offset;
+        if (len > 1024) len = 1024;
+        for (i = 0; i < len; ++i) tmp[i] = para_config_byte(context, offset + i);
+        CRC16_Update(&crc, tmp, len);
+        offset += len;
+    }
+    CRC16_Final(&crc, &result);
+    return result;
+}
