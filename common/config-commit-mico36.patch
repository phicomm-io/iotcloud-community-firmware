+static OSStatus para_write_config(mico_partition_t part, system_context_t *context, uint8_t *tmp)
+{
+    OSStatus err, write_err;
+    uint32_t offset, end, attempt;
+    uint16_t expected_crc, stored;
+    mico_logic_partition_t *partition = MicoFlashGetInfo(part);
+    err = para_config_layout(context, part);
+    if (err) return err;
+    end = partition->partition_length - CRC_SIZE;
+    expected_crc = para_config_crc(context, part, tmp);
+    /* An erased tail must not itself be a valid commit record. The seed is SDK
+     * metadata; toggling one bit changes the CRC without changing app layout. */
+    if (expected_crc == 0xffff) {
+        if (part != MICO_PARTITION_PARAMETER_1) return kWriteErr;
+        context->flashContentInRam.micoSystemConfig.seed ^= 1;
+        seedNum = context->flashContentInRam.micoSystemConfig.seed;
+        expected_crc = para_config_crc(context, part, tmp);
+    }
+    err = MicoFlashErase(part, 0, partition->partition_length);
+    if (err) return err;
+    offset = end;
+    err = MicoFlashRead(part, &offset, (uint8_t *)&stored, CRC_SIZE);
+    if (err) return err;
+    if (offset != partition->partition_length || stored != 0xffff) return kWriteErr;
+    offset = 0;
+    err = MicoFlashWrite(part, &offset, (uint8_t *)&context->flashContentInRam, sizeof(system_config_t));
+    if (err) return err;
+    if (offset != sizeof(system_config_t)) return kWriteErr;
+    offset = mico_context_section_offsets[PARA_APP_DATA_SECTION];
+    err = MicoFlashWrite(part, &offset, context->user_config_data, context->user_config_data_size);
+    if (err) return err;
+    if (offset != mico_context_section_offsets[PARA_APP_DATA_SECTION] + context->user_config_data_size) return kWriteErr;
+#ifdef MICO_EXTRA_AP_NUM
+    offset = mico_context_section_offsets[PARA_SYS_EXTRA_SECTION];
+    err = MicoFlashWrite(part, &offset, (uint8_t *)context->extra_ap, sizeof(context->extra_ap));
+    if (err) return err;
+    if (offset != mico_context_section_offsets[PARA_SYS_EXTRA_SECTION] + sizeof(context->extra_ap)) return kWriteErr;
+#endif
+    /* Verify the complete image against RAM before publishing its CRC. This
+     * catches silent/partial writes too (the MOC write wrapper returns zero). */
+    offset = 0;
+    while (offset < end) {
+        uint32_t i, start = offset, len = end - offset;
+        if (len > 1024) len = 1024;
+        err = MicoFlashRead(part, &offset, tmp, len);
+        if (err) return err;
+        if (offset != start + len) return kReadErr;
+        for (i = 0; i < len; ++i)
+            if (tmp[i] != para_config_byte(context, start + i)) return kWriteErr;
+    }
+    offset = end;
+    write_err = MicoFlashWrite(part, &offset, (uint8_t *)&expected_crc, CRC_SIZE);
+    /* A write error may occur after programming. Resolve it from actual bytes;
+     * retry bounded transient read failures, never overwrite the old backup.
+     * If all reads fail the commit is unknown: propagate that read error rather
+     * than claiming that Flash rolled back. No RAM rollback is performed here. */
+    for (attempt = 0; attempt < 3; ++attempt) {
+        offset = end;
+        err = MicoFlashRead(part, &offset, (uint8_t *)&stored, CRC_SIZE);
+        if (!err && offset == partition->partition_length)
+            return stored == expected_crc ? kNoErr : (write_err ? write_err : kWriteErr);
+        if (!err) err = kReadErr;
+    }
+    if (part == MICO_PARTITION_PARAMETER_1) {
+        para_commit_uncertain = true;
+        app_config_commit_indeterminate();
+    }
+    return err;
+}
