+/* Copy only from a fully checked source. An interrupted repair cannot erase it. */
+static int para_copy(mico_partition_t dst, mico_partition_t src)
+{
+    OSStatus err;
+    uint32_t offset, end, dst_offset;
+    uint16_t source_crc, target_crc;
+    bool valid, same;
+    uint8_t *tmp;
+    mico_logic_partition_t *source = MicoFlashGetInfo(src);
+    mico_logic_partition_t *target = MicoFlashGetInfo(dst);
+    if (dst == src || !source || !target || source->partition_length != target->partition_length)
+        return kSizeErr;
+    err = para_valid(src, &valid, &source_crc);
+    if (err) return err;
+    if (!valid) return kReadErr;
+    tmp = (uint8_t *)malloc(1024);
+    if (!tmp) return kNoMemoryErr;
+    err = MicoFlashErase(dst, 0, target->partition_length);
+    require_noerr(err, exit);
+    offset = mico_context_section_offsets[PARA_MICO_DATA_SECTION];
+    dst_offset = offset;
+    end = source->partition_length;
+    while (offset < end) {
+        uint32_t start = offset, len = end - offset;
+        if (len > 1024) len = 1024;
+        err = MicoFlashRead(src, &offset, tmp, len);
+        require_noerr(err, exit);
+        require_action(offset == start + len, exit, err = kReadErr);
+        err = MicoFlashWrite(dst, &dst_offset, tmp, len);
+        require_noerr(err, exit);
+        require_action(dst_offset == offset, exit, err = kWriteErr);
+    }
+    /* Release the copy buffer before the full CRC verifier allocates its own. */
+    free(tmp);
+    tmp = NULL;
+    err = para_valid(dst, &valid, &target_crc);
+    require_noerr(err, exit);
+    require_action(valid && target_crc == source_crc, exit, err = kWriteErr);
+    err = para_equal(src, dst, &same);
+    require_noerr(err, exit);
+    require_action(same, exit, err = kWriteErr);
+exit:
+    free(tmp);
+    return err;
+}
