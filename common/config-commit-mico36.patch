+static OSStatus para_valid(mico_partition_t part, bool *valid, uint16_t *crc)
+{
+    OSStatus err;
+    uint16_t stored;
+    uint32_t offset;
+    mico_logic_partition_t *partition = MicoFlashGetInfo(part);
+    *valid = false;
+    err = para_crc16(part, crc);
+    require_noerr(err, exit);
+    offset = partition->partition_length - CRC_SIZE;
+    err = MicoFlashRead(part, &offset, (uint8_t *)&stored, CRC_SIZE);
+    require_noerr(err, exit);
+    require_action(offset == partition->partition_length, exit, err = kReadErr);
+    *valid = is_crc_match(*crc, stored);
+exit:
+    return err;
+}
