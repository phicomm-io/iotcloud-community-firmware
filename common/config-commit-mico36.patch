+extern bool app_config_persist_allowed(void);
+
+static OSStatus internal_update_config(system_context_t * const inContext)
+{
+    OSStatus err;
+    uint16_t primary_crc, backup_crc;
+    bool primary_valid, backup_valid, same = false;
+    uint8_t *tmp = NULL;
+    if (!inContext || para_commit_uncertain) return kNotPreparedErr;
+    if (!app_config_persist_allowed()) return kNoErr;
+    err = para_config_layout(inContext, MICO_PARTITION_PARAMETER_1);
+    if (err) return err;
+    mico_rtos_lock_mutex(&para_flash_mutex);
+    /* Another caller may have latched uncertainty while this one waited. */
+    require_action(!para_commit_uncertain, exit, err = kNotPreparedErr);
+    if (!app_config_persist_allowed()) { err = kNoErr; goto exit; }
+    err = para_valid(MICO_PARTITION_PARAMETER_1, &primary_valid, &primary_crc);
+    require_noerr(err, exit);
+    err = para_valid(MICO_PARTITION_PARAMETER_2, &backup_valid, &backup_crc);
+    require_noerr(err, exit);
+    /* A previous accepted update may have left degraded redundancy. Preserve
+     * that latest committed primary before starting another transaction. */
+    if (primary_valid && backup_valid && primary_crc == backup_crc) {
+        err = para_equal(MICO_PARTITION_PARAMETER_1, MICO_PARTITION_PARAMETER_2, &same);
+        require_noerr(err, exit);
+    }
+    if (primary_valid && !same) {
+        err = para_copy(MICO_PARTITION_PARAMETER_2, MICO_PARTITION_PARAMETER_1);
+        require_noerr(err, exit);
+    }
+    tmp = (uint8_t *)malloc(1024);
+    require_action(tmp, exit, err = kNoMemoryErr);
+    err = para_write_config(MICO_PARTITION_PARAMETER_1, inContext, tmp);
+    require_noerr(err, exit);
+    /* Primary is completely verified and committed. A redundancy failure must
+     * not make the application roll RAM back while reboot selects new Flash. */
+    (void)para_write_config(MICO_PARTITION_PARAMETER_2, inContext, tmp);
+    err = kNoErr;
+exit:
+    mico_rtos_unlock_mutex(&para_flash_mutex);
+    free(tmp);
+    return err;
 }
 
