+/* CRC equality alone does not prove that two valid configurations match. */
+static OSStatus para_equal(mico_partition_t left, mico_partition_t right, bool *same)
+{
+    OSStatus err = kNoErr;
+    uint32_t offset, end;
+    uint8_t *tmp;
+    mico_logic_partition_t *a = MicoFlashGetInfo(left);
+    mico_logic_partition_t *b = MicoFlashGetInfo(right);
+    *same = false;
+    if (!a || !b || a->partition_length != b->partition_length ||
+        mico_context_section_offsets[PARA_MICO_DATA_SECTION] > a->partition_length)
+        return kSizeErr;
+    tmp = (uint8_t *)malloc(1024);
+    if (!tmp) return kNoMemoryErr;
+    offset = mico_context_section_offsets[PARA_MICO_DATA_SECTION];
+    end = a->partition_length;
+    while (offset < end) {
+        uint32_t start = offset, other = offset, len = end - offset;
+        if (len > 512) len = 512;
+        err = MicoFlashRead(left, &offset, tmp, len);
+        require_noerr(err, exit);
+        require_action(offset == start + len, exit, err = kReadErr);
+        err = MicoFlashRead(right, &other, tmp + 512, len);
+        require_noerr(err, exit);
+        require_action(other == offset, exit, err = kReadErr);
+        if (memcmp(tmp, tmp + 512, len)) goto exit;
+    }
+    *same = true;
+exit:
+    free(tmp);
+    return err;
+}
