--- /dev/null
+++ b/libraries/utilities/json_c/json_number_reent.h
@@ -0,0 +1,22 @@
+/* Keep dtoa/strtod scratch private when the RTOS has no newlib task context.
+ * Reclaim the context on every path: newlib allocates conversion scratch lazily.
+ */
+#ifndef JSON_NUMBER_REENT_H
+#define JSON_NUMBER_REENT_H
+#ifdef __NEWLIB__
+#include <reent.h>
+static int json_number_scan(const char *text, double *value)
+{
+  struct _reent context;
+  _REENT_INIT_PTR(&context);
+  int result = _sscanf_r(&context, text, "%lf", value);
+  _reclaim_reent(&context);
+  return result;
+}
+#else
+static int json_number_scan(const char *text, double *value)
+{
+  return sscanf(text, "%lf", value);
+}
+#endif
+#endif
