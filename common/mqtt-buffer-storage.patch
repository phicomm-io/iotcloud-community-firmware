+/* The shared owner supplies live-heap admission, including the old/new overlap.
+ * Reject allocations if the protocol is linked without its owning adapter. */
+__attribute__((weak)) int mqtt_buffer_allocation_permit(Client *c, size_t bytes)
+{
+    (void)c; (void)bytes;
+    return 0;
+}
+
+/* The pinned platform realloc does not release shrinking blocks and copies the
+ * requested new size on growth. Never use it for protocol buffer storage. */
+static int mqtt_buffer_resize(Client *c, unsigned char **buffer, size_t *capacity,
+                              size_t bytes, size_t preserve)
+{
+    unsigned char *next;
+    if (!bytes || preserve > *capacity || preserve > bytes ||
+        (preserve && !*buffer))
+        return 0;
+    if (*buffer && bytes == *capacity)
+        return 1;
+    if (!mqtt_buffer_allocation_permit(c, bytes))
+        return 0;
+    next = (unsigned char *)malloc(bytes);
+    if (!next)
+        return 0;
+    if (preserve)
+        memcpy(next, *buffer, preserve);
+    free(*buffer);
+    *buffer = next;
+    *capacity = bytes;
+    return 1;
+}
