+++ b/libraries/utilities/json_c/json_object.c
@@ -461,7 +461,7 @@
   char number[32];
   _REENT_INIT_PTR(&context);
   int length = _snprintf_r(&context, number, sizeof(number), "%g", jso->o.c_double);
-  _reclaim_reent(&context);
+  json_number_reclaim(&context);
   if(length < 0 || length >= (int)sizeof(number)) return -1;
   return printbuf_memappend(pb, number, length);
 #else
