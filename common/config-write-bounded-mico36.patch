+/* The pinned MOC kernel copies each write into a same-sized heap buffer.
+ * Bound that hidden allocation as well as the SDK verification scratch. */
+static OSStatus para_write_data(mico_partition_t part, uint32_t *offset, uint8_t *data, uint32_t length)
+{
+    while (length) {
+        uint32_t start = *offset, len = length > 1024 ? 1024 : length;
+        OSStatus err = MicoFlashWrite(part, offset, data, len);
+        if (err) return err;
+        /* The MOC wrapper discards errors, including allocation failures. */
+        if (*offset != start + len) return kWriteErr;
+        data += len;
+        length -= len;
+    }
+    return kNoErr;
+}
