diff --git a/MiCO/system/mico_system_para_storage.c b/MiCO/system/mico_system_para_storage.c
index e54064f..1e95cbc 100644
--- a/MiCO/system/mico_system_para_storage.c
+++ b/MiCO/system/mico_system_para_storage.c
@@ -483,6 +483,7 @@ OSStatus mico_ota_switch_to_new_fw( int ota_data_len, uint16_t ota_data_crc )
     switch_active_firmware();
 #else
     mico_logic_partition_t* ota_partition = MicoFlashGetInfo( MICO_PARTITION_OTA_TEMP );
+    boot_table_t previous_boot = sys_context->flashContentInRam.bootTable;
 
     memset( &sys_context->flashContentInRam.bootTable, 0, sizeof(boot_table_t) );
 #ifdef CONFIG_MX108
@@ -497,7 +498,10 @@ OSStatus mico_ota_switch_to_new_fw( int ota_data_len, uint16_t ota_data_crc )
     sys_context->flashContentInRam.bootTable.upgrade_type = 'U';
     sys_context->flashContentInRam.bootTable.crc = ota_data_crc;
 #endif
-    mico_system_context_update( mico_context );
+    OSStatus status = mico_system_context_update( mico_context );
+    /* A failed commit must not arm a future configuration save in RAM. */
+    if (status != kNoErr) sys_context->flashContentInRam.bootTable = previous_boot;
+    return status;
 #endif
     return kNoErr;
 }
