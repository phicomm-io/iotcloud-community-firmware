-    if(decodePacket(c, &rem_len, left_ms(&packet_timer)) <= 0){
-      rc = MQTT_SOCKET_ERR;
-      goto exit;
-    }
-    len += MQTTPacket_encode(c->readbuf + 1, rem_len); /* put the original remaining length back into the buffer */
-
-    /* Only the encoded fixed header exists before reading the payload. */
-    if((len + rem_len) > c->readbuf_size &&
-       !mqtt_buffer_resize(c, &c->readbuf, &c->readbuf_size, len + rem_len, len)){
-      mqtt_client_log("no enough memory to recv data!");
-      rc = MQTT_BUFFER_OVERFLOW;
-      goto exit;
-    }
-
-    /* 3. read the rest of the buffer using a callback to supply the rest of the data */
-    if (rem_len > 0 && (c->ipstack->mqttread(c->ipstack, c->readbuf + len, rem_len, left_ms(&packet_timer)) != rem_len))
-        goto exit;
-
-    header.byte = c->readbuf[0];
-    rc = header.bits.type;
-exit:
-    return rc;
-}
