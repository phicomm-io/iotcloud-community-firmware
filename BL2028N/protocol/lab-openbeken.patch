+int MQTTClientDeinit(Client* c)
+{
+  int rc = MQTT_FAILURE;
+
+  if(NULL != c){
+    if(NULL != c->buf){
+      free(c->buf);
+      c->buf = NULL;
+      c->buf_size = 0;
+    }
+    if(NULL != c->readbuf){
+      free(c->readbuf);
+      c->readbuf = NULL;
+      c->readbuf_size = 0;
+    }
+    memset((void*)c, 0, sizeof(Client));
+    rc = MQTT_SUCCESS;
+  }
+  else{
+    mqtt_client_log("ERROR: MQTTClientDeinit param is null.");
+  }
+
+  return rc;
+}
