+// only used in single-threaded mode where one command at a time is in process
+int waitfor(Client* c, int packet_type, Timer* timer)
+{
+    int rc = MQTT_FAILURE;
+
+    do
+    {
+        if (expired(timer))
+            break; // we timed out
+
+        rc = cycle(c, timer);
+    }
+    while ((rc != packet_type) && rc >= 0);
+
+    return rc;
+}
