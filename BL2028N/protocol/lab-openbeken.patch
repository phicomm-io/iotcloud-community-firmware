+int MQTTYield(Client* c, int timeout_ms)
+{
+  int rc = MQTT_SUCCESS;
+  Timer timer;
+
+  InitTimer(&timer);
+  countdown_ms(&timer, timeout_ms);
+  if (cycle(c, &timer) == MQTT_FAILURE)
+  {
+    rc = MQTT_FAILURE;
+  }
+
+  return rc;
+}
