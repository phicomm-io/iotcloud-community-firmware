/* Actual A1 native/filter builders, real JSON ownership and shared session. */
#include "common/json_owned.h"
typedef struct {char name[96];} a1_config_t;
#define FEATURE_TOPIC_MAX 512
#define A1_FILTER_MAX_HOURS 87600
#define A1_VERSION "host"
static char base[192],availability_topic[512];
#define mqtt_owner_thread thread
static bool builder_bound,identity_failure,encoding_failure,builder_closed;
static unsigned builder_mode,builder_sends,builder_turn,builder_done_at;
static bool discovery_deferred;
static uint32_t discovery_retry_at;
static bool feature_bound(void){return builder_bound;}
static bool feature_ha_device(char *id,size_t is,char *name,size_t ns,bool *grouped){
    if(identity_failure)return false;
    snprintf(id,is,"parent");snprintf(name,ns,"parent");*grouped=false;return true;
}
static int builder_sender(const char *topic,const char *wire,bool retained){
    builder_sends++;fail_send=builder_mode==5;int rc=sender(topic,wire,retained);fail_send=false;return rc;
}
static int builder_encode(int(*p)(const char*,const char*,bool),const char*t,json_object*o,bool retain,service_mqtt_json_scope *scope){
    if(encoding_failure)fail_allocation=native_allocs+1;
#ifdef PH_MQTT_APP_SOURCES
    return service_mqtt_optional_send(p,t,o,retain,scope);
#else
    service_mqtt_json_end(scope);return json_owned_publish(p,t,o,retain);
#endif
}
#define publish builder_sender
#define json_owned_publish builder_encode
#define service_mqtt_optional_send builder_encode
/* BUILDERS */
#undef service_mqtt_optional_send
#undef json_owned_publish
#undef publish
static int builder_prepare(void *context,ph_mqtt_connection *spec){
    (void)context;rx_at=rx_size=tx_size=0;fail_send=missing_ack=open_fail=false;
    *spec=(ph_mqtt_connection){&account,"broker","","","host","tx/availability",1883,50,NULL};
    return PH_MQTT_PREPARE_READY;
}
static bool builder_subscription(void*c,unsigned i,ph_mqtt_subscription*s){(void)c;(void)i;(void)s;return false;}
static int builder_initial(void*c){(void)c;return MQTT_SUCCESS;}
static int builder_cycle(void*c){
    (void)c;a1_config_t cfg={"host"};unsigned sent=publications;
    builder_sends=0;builder_bound=identity_failure=builder_mode==2;
    encoding_failure=builder_mode==3||builder_mode==4;
    if(builder_mode<2 && !builder_turn)fail_allocation=native_allocs+1;
    if(builder_turn){encoding_failure=false;now_ms+=1000u;}
    int rc=discovery(&cfg,builder_mode==1||builder_mode==2||builder_mode==4?4:0);
    fail_allocation=0;
    if(builder_mode==5) { assert(rc<0 && builder_sends==1);return rc; }
    if(builder_mode==2) { assert(rc==-1 && !builder_sends && publications==sent);return rc; }
    if(!builder_turn++) { assert(rc==PH_MQTT_MORE && !builder_sends && publications==sent);return rc; }
    assert(rc==0 && builder_sends==1 && publications==sent+1);
    builder_done_at=now_ms;return rc;
}
static void builder_closing(void*c,bool connected,int rc){
    (void)c;assert(connected);ph_mqtt_diagnostics d;ph_mqtt_snapshot(&d);
    if(builder_mode==5) {
        assert(rc<0 && d.failure.reason==PH_MQTT_CAUSE_WRITE && d.failure.operation==PH_MQTT_ERROR_PUBLISH);
    } else if(builder_mode==2) {
        assert(rc==-1 && d.failure.operation==PH_MQTT_ERROR_APP_DISCOVERY_IDENTITY);
        assert(d.last_error==-1 && !d.failure.packet_bytes);
    } else {
        assert(rc==0 && !d.errors && !d.failure.reason && !d.failure.operation);
    }
    printf("actual A1 builder mode=%u resource retry/identity fatal clean PASS\n",builder_mode);
    builder_closed=true;
}
static bool builder_stop(void*c){(void)c;return builder_closed || (builder_turn>=2 && now_ms!=builder_done_at);}
int main(void){
    service_init();heap_capacity=64000;
    assert(mqtt_account_init(&account,1,"a1","test","aabbccddeeff"));
    strcpy(base,account.base);assert(mqtt_leaf(&account,"availability",availability_topic,sizeof(availability_topic)));
    assert(ph_mqtt_owner_init(&account,8192,&thread,accept));
    ph_mqtt_session_hooks h={NULL,builder_prepare,builder_subscription,builder_initial,builder_cycle,builder_closing,NULL,builder_stop};
    for(builder_mode=0;builder_mode<6;builder_mode++){
        /* A fresh owner lifecycle keeps independent fatal-control counters separate. */
        if(builder_mode){ph_mqtt_owner_end();assert(ph_mqtt_owner_init(&account,8192,&thread,accept));}
        discovery_deferred=false;builder_turn=0;builder_closed=false;ph_mqtt_session_run(&client,&h);
        assert(builder_closed && !native_live && !charged_live);
    }
    ph_mqtt_owner_end();return 0;
}
